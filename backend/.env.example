# Athirai Jewelry Backend Environment Configuration
DEBUG=True
SECRET_KEY=athirai-luxury-jewels-secret-key-production-ready-2026
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*
CORS_ALLOW_ALL_ORIGINS=True

# Copy the Neon connection URL here in backend/.env, never in Flutter code.
# Leave blank for the existing local SQLite database.
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# SSO Provider Integrations (Enterprise Ready)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Registration OTP delivery (configure credentials on the backend only).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
