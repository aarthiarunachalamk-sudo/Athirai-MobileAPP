# Copy the Neon connection URL here in backend/.env, never in Flutter code.
# Leave blank for the existing local SQLite database.
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

